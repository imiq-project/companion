# Linux service configuration. Set real paths and a private random token.
PORT=8077
COMPANION_BIND_HOST=127.0.0.1
COMPANION_WSGI_BIND=127.0.0.1:8077
COMPANION_WSGI_WORKERS=1
COMPANION_WSGI_THREADS=4
COMPANION_WSGI_TIMEOUT=240
COMPANION_API_TOKEN=
COMPANION_STATE_DIR=/var/lib/companion
COMPANION_JOURNEY_STORAGE_ENABLED=1
COMPANION_JOURNEY_DB=/var/lib/companion-user/journeys.sqlite3
COMPANION_SERVICE_MANAGER=systemd
COMPANION_JAVA=/usr/bin/java
COMPANION_OTP_JAR=/opt/companion/runtime/otp-shaded-2.7.0.jar
COMPANION_OTP_PORT=8091
COMPANION_REALTIME_PORT=8092
COMPANION_TRANSIT_BUILD_TIMEOUT=1800
COMPANION_TRANSIT_MIN_FREE_MB=2048
COMPANION_OTP_BASE_URL=http://127.0.0.1:8091
COMPANION_OTP_STATUS_URL=http://127.0.0.1:8092/status
COMPANION_ROUTING_BASE_URL=https://imiq-public.et.uni-magdeburg.de/api/routing
COMPANION_GRAPHHOPPER_BASE_URL=https://imiq-public.et.uni-magdeburg.de/api/graphhopper
COMPANION_ORION_BASE_URL=https://imiq-public.et.uni-magdeburg.de/api/orion
# Development-only block 04 transfer remains opt-in and loopback-only.
COMPANION_BLOCK04_LOCAL_TEST=0
COMPANION_GEOCODING_BASE_URL=https://photon.komoot.io
COMPANION_GEOCODING_TIMEOUT_SECONDS=2
COMPANION_ROUTING_TIMEOUT_SECONDS=120
COMPANION_GEOMETRY_TIMEOUT_SECONDS=15
COMPANION_OTP_TIMEOUT_SECONDS=20
COMPANION_MAX_BODY_BYTES=67108864
COMPANION_MAX_BATCH_REQUESTS=16
COMPANION_MAX_INFLIGHT_COMPUTE=1
COMPANION_PROVIDER_PARALLELISM=3
COMPANION_TILE_MAX_DOWNLOADS=4
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
