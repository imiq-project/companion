# Local development only. Copy to app-backend/.env; never commit the real file.
PORT=8077
COMPANION_BIND_HOST=127.0.0.1
COMPANION_OTP_PORT=8091
COMPANION_REALTIME_PORT=8092
COMPANION_OTP_BASE_URL=http://127.0.0.1:8091
COMPANION_OTP_STATUS_URL=http://127.0.0.1:8092/status
COMPANION_SERVICE_MANAGER=processes
COMPANION_JOURNEY_STORAGE_ENABLED=1
# Empty token is intended only for a private loopback development setup.
COMPANION_API_TOKEN=
COMPANION_ROUTING_BASE_URL=https://imiq-public.et.uni-magdeburg.de/api/routing
COMPANION_GRAPHHOPPER_BASE_URL=https://imiq-public.et.uni-magdeburg.de/api/graphhopper
COMPANION_ORION_BASE_URL=https://imiq-public.et.uni-magdeburg.de/api/orion
COMPANION_GEOCODING_BASE_URL=https://photon.komoot.io
COMPANION_GEOCODING_TIMEOUT_SECONDS=2
# Synthetic Atlas profile-transfer route stays disabled in normal operation.
COMPANION_BLOCK03_ATLAS_TEST_ENABLED=0
# Requires the separate local panel/Atlas test mode; never enables pilot enrollment.
COMPANION_BLOCK04_LOCAL_TEST=0
# Optional driver: deploy/requirements-mongodb.txt. Keep URI in private config.
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1

# Panel account login; passwords are entered in Android, never in this file.
COMPANION_PANEL_LOGIN_ENABLED=1
COMPANION_PANEL_ORIGIN=https://imiq-staging.et.uni-magdeburg.de
COMPANION_PANEL_STUDY_ID=app_imiq_test
# Optional owner-authorized local integration; keep disabled until configured.
COMPANION_PANEL_ATLAS_LOCAL_TEST=0
COMPANION_PROFILE_UPLOAD_LOCAL_VALIDATION=0
COMPANION_BLOCK05_LOCAL_TEST=0
COMPANION_BLOCK06A_LOCAL_TEST=0
COMPANION_BLOCK06B_LOCAL_TEST=0
