{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:companion:longitudinal-prospective-v2",
  "title": "Longitudinal archived shadow forecast and frozen evaluation V2",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/forecast"
    },
    {
      "$ref": "#/$defs/evaluation"
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "selected_at",
        "initial_passport"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            "longitudinal-prospective-source-v2",
            "d-day-prospective-source-v2"
          ]
        },
        "selected_at": {
          "type": "string"
        },
        "initial_passport": {
          "type": "object"
        },
        "learned_version": {
          "type": [
            "object",
            "null"
          ]
        },
        "evidence_exclusions": {
          "type": [
            "object",
            "null"
          ]
        },
        "selection_rule": {
          "type": "string"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "search_id",
        "as_of",
        "source",
        "candidates"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            "longitudinal-prospective-request-v2",
            "d-day-prospective-request-v2"
          ]
        },
        "search_id": {
          "type": "string",
          "minLength": 1
        },
        "as_of": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "prediction_id",
              "mode",
              "context"
            ],
            "properties": {
              "prediction_id": {
                "type": "string",
                "minLength": 1
              },
              "mode": {
                "enum": [
                  "walk",
                  "bike",
                  "pt",
                  "car"
                ]
              },
              "context": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "forecast": {
      "type": "object",
      "required": [
        "schema_version",
        "search_id",
        "as_of",
        "request_digest",
        "source_digest",
        "source_passport_id",
        "source_selected_at",
        "evidence_cutoff",
        "computed_at",
        "forecast_method",
        "targets",
        "learning_applied_to_active_passport",
        "hotco_modified",
        "stored_on_server"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            "longitudinal-prospective-forecast-v2",
            "d-day-prospective-forecast-v2"
          ]
        },
        "search_id": {
          "type": "string"
        },
        "as_of": {
          "type": "string"
        },
        "request_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_passport_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_selected_at": {
          "type": "string"
        },
        "evidence_cutoff": {
          "type": [
            "string",
            "null"
          ]
        },
        "computed_at": {
          "type": "string"
        },
        "forecast_method": {
          "const": "archived_posterior_no_refit_v2"
        },
        "targets": {
          "type": "object",
          "required": [
            "comfort",
            "affect"
          ]
        },
        "learning_applied_to_active_passport": {
          "const": false
        },
        "hotco_modified": {
          "const": false
        },
        "stored_on_server": {
          "const": false
        }
      }
    },
    "evaluation": {
      "type": "object",
      "required": [
        "schema_version",
        "event_id",
        "journey_id",
        "choice_event_id",
        "learning_applied",
        "scores",
        "status",
        "eligibility_snapshot"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            "longitudinal-prospective-evaluation-v2",
            "d-day-prospective-evaluation-v2"
          ]
        },
        "event_id": {
          "type": "string"
        },
        "journey_id": {
          "type": "string"
        },
        "choice_event_id": {
          "type": "string"
        },
        "learning_applied": {
          "const": false
        },
        "scores": {
          "type": "array"
        },
        "status": {
          "enum": [
            "scored",
            "unscored"
          ]
        },
        "eligibility_snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "exclusions",
            "exclusions_digest"
          ],
          "properties": {
            "schema_version": {
              "enum": [
                "longitudinal-evaluation-eligibility-v1",
                "d-day-evaluation-eligibility-v1"
              ]
            },
            "exclusions": {
              "type": [
                "object",
                "null"
              ]
            },
            "exclusions_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    }
  }
}
